# SecureContent AI — environment template
# Copy to .env and fill secrets locally. Never commit real keys.
# See README.md "Configuration" and docs/architecture.md.

# Database
DATABASE_URL="file:./dev.db"
# Resolves to prisma/dev.db locally. In Docker/production override with file:/app/db/custom.db

# LLM — server-side only (Next.js API routes / src/lib/ai/transform.ts)
# Flow: Next.js Frontend -> Next.js API (server) -> Security Pipeline -> Gemini/Groq
# Never expose keys to client code, screenshots, README, or NEXT_PUBLIC_* vars.
GEMINI_API_KEY=""          # primary — Google AI Studio: https://aistudio.google.com/apikey
GROQ_API_KEY=""            # fallback — Groq console: https://console.groq.com/keys (model: openai/gpt-oss-120b)
GEMINI_MODEL="gemini-1.5-flash"
GROQ_MODEL="openai/gpt-oss-120b"

# Optional overrides
# DOCLING_WORKER_URL="http://localhost:8001/parse"

#Offline mock behaviour: in production, transformation requires real keys.
# Set ALLOW_OFFLINE_MOCK=true to permit deterministic fallback when providers are unreachable.
# In development/test the mock is allowed automatically when no keys are set.
# ALLOW_OFFLINE_MOCK="false"

# Legacy (deprecated) — kept for backwards compat, prefer GEMINI_API_KEY/GROQ_API_KEY
# Z_AI_API_KEY=""

# Optional production add-ons (add when you need them — keep empty in prototype)
# DATABASE_URL="postgresql://user:pass@host:5432/securecontent"  # use Postgres in prod
# JWT_SECRET=""
# REDIS_URL="redis://localhost:6379"
# STORAGE_BUCKET=""
